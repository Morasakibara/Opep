# ============================================================
# OPEP API — Environment Variables
# Copy to .env and fill in your values for local development.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=opep
DB_PASSWORD=opep_dev_secret
DB_NAME=opep_db

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth / JWT ---
JWT_SECRET=super_secret_sovereign_key
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=*

# --- Rate Limiting (Throttler tiers) ---
# All limits are per single client IP. Tune in production based on traffic.
# Per-tier TTL is the rolling window in milliseconds.
THROTTLE_LONG_LIMIT=50           # default traffic ceiling per minute (was 100; tightened)
THROTTLE_LONG_TTL=60000
THROTTLE_MEDIUM_LIMIT=30         # rolling 60s window (tightened from previous 20/10s)
THROTTLE_MEDIUM_TTL=60000
THROTTLE_SHORT_LIMIT=3           # rolling 1s window — only enforced when not explicitly skipped
THROTTLE_SHORT_TTL=1000
THROTTLE_PUBLIC_LIMIT=30         # applied to public/unauth endpoints (trips/available, trips/search, notifications/my)
THROTTLE_PUBLIC_TTL=60000

# --- Payment Providers (mobile money) ---
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_SUBSCRIPTION_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# --- Stripe (international cards) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Offline QR validation ---
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_PUBLIC_KEY=

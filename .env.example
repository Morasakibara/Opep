#   cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/opep

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── RSA Keys (QR Ticket Signing) ───────────────────────────────────────────
# Generate keys: cd apps/api && npm run keygen
# Provide EITHER paths to PEM files OR the key content directly.
RSA_PRIVATE_KEY_PATH=./keys/private.pem
RSA_PUBLIC_KEY_PATH=./keys/public.pem
# Inline keys (base64 or PEM). Used if KEY_PATH is empty.
# RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
# RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...

# ─── Rate Limiting (Throttler) ──────────────────────────────────────────────
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=50
THROTTLE_MEDIUM_TTL=60000
THROTTLE_MEDIUM_LIMIT=30
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_PUBLIC_TTL=60000
THROTTLE_PUBLIC_LIMIT=30

# ─── Africa's Talking (SMS / WhatsApp) ──────────────────────────────────────
# Set AT_ACTIVE=true to hit the real AT API.  Use 'sandbox' as username
# for development.  AT_API_KEY is your secret API key from the AT dashboard.
AT_ACTIVE=false
AT_USERNAME=sandbox
AT_API_KEY=

# ─── Stripe (Payments) ──────────────────────────────────────────────────────
# Webhook secret for verifying Stripe webhook signatures.
STRIPE_WEBHOOK_SECRET=
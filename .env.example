# =============================================================================
# OPEP - Variables d'environnement (Template)
# Copier ce fichier vers .env et adapter les valeurs
# =============================================================================
# cp .env.example .env

# --------------- Database ---------------
DATABASE_URL=postgresql://opep:opep_dev_secret@localhost:5432/opep_db
# Pour les tests CI :
# DATABASE_URL=postgresql://opep:opep_dev_secret@localhost:5432/opep_db_test

# --------------- Redis ---------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------- JWT ---------------
JWT_SECRET=opep_jwt_super_secret_change_in_prod_min_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=opep_refresh_super_secret_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# --------------- RSA Keys (QR Ticket Signing) ---------------
# Generer les cles : bash scripts/generate-keys.sh
# Ou : cd apps/api && npm run keygen
RSA_PRIVATE_KEY_PATH=./keys/private.pem
RSA_PUBLIC_KEY_PATH=./keys/public.pem
# Alternative : fournir directement le contenu des cles :
# RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
# RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...

# --------------- Paiements (Mode DEV) ---------------
PAYMENT_MODE=mock   # "mock" | "sandbox" | "live"

# Stripe (cles de test)
STRIPE_SECRET_KEY=sk_test_XXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXX

# MTN Mobile Money (sandbox)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_PRIMARY_KEY=mock_mtn_key

# Orange Money (sandbox)
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev
ORANGE_MONEY_AUTH_HEADER=mock_orange_auth

# --------------- Throttle / Rate Limiting ---------------
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=50
THROTTLE_MEDIUM_TTL=60000
THROTTLE_MEDIUM_LIMIT=30
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_PUBLIC_TTL=60000
THROTTLE_PUBLIC_LIMIT=30

# --------------- App ---------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=*
